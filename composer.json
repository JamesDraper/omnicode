{
    "bin": ["src/omnicode"],
    "autoload": {
        "psr-4": {
            "OmniCode\\": "src/autoload"
        }
    },
    "require": {
        "php": ">=8.5.1",
        "composer-runtime-api": "^2.2",
        "symfony/console": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "test": [
            "@phpstan",
            "@php-cs-fixer"
        ],
        "phpstan": "phpstan analyse",
        "php-cs-fixer": "php-cs-fixer fix -v --diff --dry-run"
    }
}
