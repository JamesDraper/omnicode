{
    "bin": ["src/omnicode"],
    "autoload": {
        "psr-4": {
            "OmniCode\\": "src/autoload"
        }
    },
    "autoload-dev": {
        "files": [
            "tests/TestCase.php",
            "tests/tokenizer/TokenizerTest.php"
        ]
    },
    "require": {
        "php": ">=8.5.1",
        "composer-runtime-api": "^2.2",
        "symfony/console": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "test": [
            "@phpunit",
            "@phpstan",
            "@php-cs-fixer"
        ],
        "phpunit": [
            "@phpunit.tokenizer"
        ],
        "phpunit.coverage": "phpunit --coverage-html coverage",
        "phpunit.tokenizer": "phpunit --testsuite=tokenizer",
        "phpstan": "phpstan analyse",
        "php-cs-fixer": "php-cs-fixer fix -v --diff --dry-run"
    }
}
